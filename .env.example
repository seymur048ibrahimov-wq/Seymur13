# SEYMUR13 — .env nümunəsi
# Kopyala:  cp .env.example .env
# Sonra .env-i doldur. .env HEÇ VAXT git-ə commit olunmur (.gitignore-da bağlıdır).
# Railway/Render-də: bu faylı yükləmə — hər dəyişəni hostinqin Variables bölməsinə əl ilə yaz.

# ============ TELEGRAM (minimum bunlar lazımdır) ============
# BotFather-dan alınan token
TELEGRAM_BOT_TOKEN=8703822366:AAH3jf_GVlkWSQf7AAOFNt3imlCcRP3ds_k
# Botuna /start yaz, sonra https://api.telegram.org/bot8703822366:AAH3jf_GVlkWSQf7AAOFNt3imlCcRP3ds_k/getUpdates ilə tap
TELEGRAM_CHAT_ID=7645481340

# ============ ADMIN API TƏHLÜKƏSİZLİYİ ============
# Boş qalarsa: /api/trade, /api/close, /api/scanner, /api/balance, /api/positions,
# /api/notify TAMAMILƏ bağlı olur (heç kim çağıra bilməz). Özün uzun/təsadüfi bir açar seç.
ADMIN_API_KEY=Seymurneyjem13122025@BTC2026!

# ============ OKX (yalnız real balans/mövqe/ticarət üçün lazımdır) ============
# Sadəcə Telegram siqnalı üçün bunlar boş qala bilər.
OKX_API_KEY=f5440353-6d41-456f-833b-e73a59429786
OKX_API_SECRET=D058A1821B2F8CFABE425DACFFD4DDB7
OKX_PASSPHRASE=Seymurneyjem13122025@
# true = demo/paper trading mühiti
OKX_DEMO=false

# ============ TİCARƏT AÇAR-QAPAYICILARI ============
# false olduqda bot YALNIZ siqnal göndərir, real order getmir
TRADING_ENABLED=false
# true olduqda MIN_CONFIDENCE-i keçən siqnallar avtomatik açılır (TRADING_ENABLED də true olmalıdır)
AUTO_TRADE=false

# ============ SERVER / INFRA ============
PORT=8787
# index.html/dashboard hansı origin-dən fetch edəcək (təhlükəsizlik üçün * yerinə öz domenini yaz)
CORS_ORIGIN=*
# Boş saxlasan state /tmp faylında saxlanır (Railway-də redeploy zamanı SİLİNİR).
# Doldursan (Railway Postgres plugin-i) state Postgres-də qalıcı olur — tövsiyə olunur.
DATABASE_URL=
# DATABASE_URL boşdursa istifadə olunan yerli fayl (Railway-də /tmp qalıcı deyil)
STATE_FILE=/tmp/seymur13-state.json

# ============ SKAN SİYAHISI ============
# Boş = daxili default siyahı. AUTO_TOP30 = OKX-da real 24saatlıq həcmə görə ən likvid 30 SWAP.
# Ya da özün ver: BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP
SCAN_SYMBOLS=

# ============ SİQNAL / RİSK PARAMETRLƏRİ ============
MIN_CONFIDENCE=64
CONFIDENCE_STEP=15
SIGNAL_COOLDOWN_MIN=30
# Boş = SIGNAL_COOLDOWN_MIN-in yarısı (min. 5)
BTC_COOLDOWN_MIN=
# Siqnal qiyməti ilə icra anındakı bazar qiyməti arasında icazə verilən max fərq (%)
MAX_SLIPPAGE_PCT=0.4
# Hər əməliyyatda riskə atılan equity faizi (auto-trade üçün)
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
# Gündəlik equity-nin bu faizindən çox itki -> auto-trade avtomatik dayanır (kill-switch)
MAX_DAILY_LOSS_PCT=5

# ============ LEVERAGE TIER-LƏRİ (etibar % + ATR-ə görə) ============
# Heç bir tier uyğun gəlməyəndə son fallback
DEFAULT_LEVERAGE=5
# Tier1: ən yüksək etibar + ən aşağı volatilite -> ən yüksək leverage
LEVERAGE_TIER1_CONF=85
LEVERAGE_TIER1_ATR=1.5
LEVERAGE_TIER1=10
LEVERAGE_TIER2_CONF=72
LEVERAGE_TIER2_ATR=2.5
LEVERAGE_TIER2=5
LEVERAGE_TIER3_CONF=50
LEVERAGE_TIER3=3
# 50%-dən aşağı etibar -> minimal leverage
LEVERAGE_LOW_CONF=1
# Simvola görə leverage TAVANI (tier-in verdiyini keçə bilməz, yalnız aşağı sala bilər)
# Format: BTC-USDT-SWAP:10,ETH-USDT-SWAP:8,DOGE-USDT-SWAP:3
SYMBOL_LEVERAGE=
